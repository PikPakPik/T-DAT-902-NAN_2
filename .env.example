# Frontend
MAPBOX_TOKEN=

# Airflow (utilisateur UI/API cree par airflow-init ; obligatoire avant le premier up)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__API_AUTH__JWT_SECRET=

# Ports
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_FLOWER_PORT=5555
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional image overrides
AIRFLOW_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
