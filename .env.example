# Frontend
MAPBOX_TOKEN=

# Airflow (utilisateur UI/API cree par airflow-init ; obligatoire avant le premier up)
# AIRFLOW_UID doit correspondre a l'UID de l'hote (id -u) pour les permissions des volumes montes
AIRFLOW_UID=1000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__API_AUTH__JWT_SECRET=secret


# Connexion Postgres (defaut = conteneur local postgis)
POSTGIS_HOST=postgis
# POSTGIS_PORT optionnel : si absent, POSTGIS_PUBLISH_PORT est utilise
POSTGIS_PUBLISH_PORT=5432

# Connexion Mongo (defaut = conteneur local mongodb)
MONGODB_HOST=mongodb
# MONGODB_PORT optionnel : si absent, MONGODB_PUBLISH_PORT est utilise
MONGODB_PUBLISH_PORT=27017

# Datastores — identifiants
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=homepedia

MONGO_USERNAME=root
MONGO_PASSWORD=example
MONGO_DATABASE=homepedia